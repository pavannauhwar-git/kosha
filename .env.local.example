# Required for app runtime
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional — enables Sentry error monitoring in production
# Get your DSN from: https://sentry.io → Project Settings → Client Keys
# Leave blank to disable (falls back to console + runtimeMonitor)
VITE_SENTRY_DSN=

# Optional — enables source map uploads on production builds
# Auth token: sentry.io → Settings → Auth Tokens → Create Token
# Scopes needed: project:releases, org:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Base URL used by test_join_flow.mjs
APP_BASE_URL=http://localhost:5173

# Live tests refuse to run unless this matches the project ref in
# VITE_SUPABASE_URL (the part before .supabase.co)
E2E_EXPECTED_PROJECT_REF=your-project-ref

# Three different test accounts
E2E_CREATOR_EMAIL=creator@example.com
E2E_CREATOR_PASSWORD=change-me
E2E_JOINER_EMAIL=joiner@example.com
E2E_JOINER_PASSWORD=change-me
E2E_SESSION_EMAIL=session@example.com
E2E_SESSION_PASSWORD=change-me
